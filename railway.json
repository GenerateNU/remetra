{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "dockerfilePath": "Dockerfile.backend"
  },
  "deploy": {
    "preDeployCommand": "uv run python scripts/init_db.py && uv run python scripts/seed_taxonomy.py",
    "startCommand": "sh -c 'uv run uvicorn main:app --host 0.0.0.0 --port $PORT'",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 300
  }
}

FROM python:3.11-slim

WORKDIR /app

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

COPY backend/pyproject.toml backend/uv.lock* ./

RUN uv sync --frozen

COPY backend/ .

ENV PATH="/app/.venv/bin:$PATH"

EXPOSE 8000

# Runs init_db + seed_taxonomy, then uvicorn (see scripts/start.sh). Railway overrides this
# via startCommand in railway.json to drop --reload.
CMD ["sh", "scripts/start.sh", "--reload"]

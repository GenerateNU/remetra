# Copy this file to .env and fill in values
# EXPO_PUBLIC_ prefix makes variables available in the Expo bundle (client-side)

# API base URL — set to production Railway URL or http://localhost:8000 for local dev
EXPO_PUBLIC_API_URL=http://localhost:8000

# Clerk Expo Public Key
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your-key-here

# Ask Remetra uses POST /chat. Set to true to demo every design screen with local mock replies instead.
EXPO_PUBLIC_CHAT_MOCK=false